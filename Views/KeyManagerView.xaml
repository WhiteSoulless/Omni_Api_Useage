<UserControl x:Class="OmniKeyStudio.Views.KeyManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:OmniKeyStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:KeyManagerViewModel}"
             d:DesignHeight="720" d:DesignWidth="920">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Akıllı API Anahtarı Dedektörü ve Kasası" 
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Herhangi bir AI sağlayıcısına ait anahtarı yapıştırın; formatı otomatik tespit edilir, dilediğiniz gibi seçilebilir veya doğrudan kaydedilebilir."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Key Input & Auto-Detection Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Anahtarınızı Buraya Yapıştırın:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Otomatik Analiz &amp; Seçim Devrede" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>

                <TextBox Style="{StaticResource ModernTextBox}" 
                         Text="{Binding InputKey, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="12,10"
                         Tag="Örn: AIzaSy..., gsk_..., sk-proj-..., sk-..., sk-or-v1-..., xai-..."
                         ToolTip="OpenAI, Gemini, Claude, Groq, OpenRouter, DeepSeek veya xAI anahtarınızı buraya yapıştırın."/>

                <!-- Provider Selector & Detection Card -->
                <Border Style="{StaticResource ModernSubCard}" Margin="0,12,0,0" Background="#141721" BorderBrush="#3B425A" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Provider Selector Dropdown & Auto Detection Badge -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Hedef Sağlayıcı:" Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding AllProviders}" 
                                      SelectedItem="{Binding SelectedProvider}"
                                      Height="34" Margin="0,0,15,0"
                                      Background="{StaticResource SurfaceDarkBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>

                            <Border Grid.Column="2" Background="#1B2236" CornerRadius="6" Padding="8,4" BorderThickness="1" BorderBrush="#2D3A5C" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tespit: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding DetectedProvider}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding DetectionConfidence, StringFormat=' ({0})'}" Foreground="{StaticResource InfoBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 1: Reason and Explanation -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DetectionReason}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding PatternMatch, StringFormat='Kalıp: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Optional Custom Base URL -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Özel Base URL (Opsiyonel):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" 
                             Text="{Binding CustomBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Özel bir OpenAI-uyumlu bulut sunucusu veya uzak API proxy için (örn: https://api.my-gateway.com/v1)"/>
                </Grid>

                <!-- Action Buttons & Status -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ProbeStatus}" Foreground="{StaticResource InfoBrush}" 
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>

                    <Button Grid.Column="1" Content="Temizle" Style="{StaticResource ModernSecondaryButton}" 
                            Command="{Binding ClearInputCommand}" Margin="0,0,8,0" Padding="10,8"/>

                    <!-- Direct Save (Never fails) -->
                    <Button Grid.Column="2" Content="💾 Kaydet" 
                            Style="{StaticResource ModernSecondaryButton}"
                            Command="{Binding SaveDirectlyCommand}"
                            ToolTip="Ağ engeli veya kota sorgusu beklemeden anahtarı doğrudan kasaya ekler."
                            Margin="0,0,8,0" Padding="12,8"/>

                    <!-- Validate & Probe Online -->
                    <Button Grid.Column="3" Content="⚡ Doğrula &amp; Kaydet" 
                            Style="{StaticResource ModernSecondaryButton}"
                            Command="{Binding ValidateAndSaveCommand}"
                            IsEnabled="{Binding IsProbing, Converter={x:Null}}"
                            Margin="0,0,8,0" Padding="12,8"/>

                    <!-- Start Chat Immediately -->
                    <Button Grid.Column="4" Content="🚀 Bu Anahtarla Hemen Sohbete Başla" 
                            Style="{StaticResource ModernPrimaryButton}"
                            Background="#10B981"
                            Command="{Binding StartChatWithCurrentKeyCommand}"
                            ToolTip="Anahtarı anında kaydeder ve sohbet ekranını bu sağlayıcıyla açar."
                            Padding="16,8"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Saved Keys Vault Section -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kayıtlı API Anahtarları (Windows DPAPI Kasası)" 
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SavedKeys.Count, StringFormat='Toplam {0} Anahtar'}" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <!-- List of Keys -->
                <ListBox Grid.Row="1" ItemsSource="{Binding SavedKeys}" 
                         SelectedItem="{Binding SelectedKey}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernSubCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Info -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Provider}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#162D24">
                                                <TextBlock Text="{Binding MaskedKey}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DisplaySubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Right: Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🚀 Sohbete Başla" Style="{StaticResource ModernPrimaryButton}" 
                                                Background="#10B981"
                                                Padding="10,5" FontSize="12" Margin="0,0,8,0"
                                                Command="{Binding DataContext.StartChatWithSavedKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Test Et" Style="{StaticResource ModernSecondaryButton}" 
                                                Padding="10,5" FontSize="12" Margin="0,0,8,0"
                                                Command="{Binding DataContext.TestSelectedKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Sil" Style="{StaticResource ModernDangerButton}"
                                                Command="{Binding DataContext.DeleteKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
