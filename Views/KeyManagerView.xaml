<UserControl x:Class="OmniKeyStudio.Views.KeyManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:OmniKeyStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:KeyManagerViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Akıllı API Anahtarı Dedektörü ve Kasası" 
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Herhangi bir AI sağlayıcısına ait anahtarı yapıştırın; formatı otomatik tespit edilir, doğrulanır ve Windows DPAPI ile güvenle şifrelenir."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Key Input & Auto-Detection Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Anahtarı (Herhangi bir sağlayıcı):" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Otomatik Algılama Devrede" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>

                <TextBox Style="{StaticResource ModernTextBox}" 
                         Text="{Binding InputKey, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="12,10"
                         Tag="Örn: gsk_..., AIzaSy..., sk-proj-..., sk-or-v1-..., sk-ant-..."
                         ToolTip="OpenAI, Gemini, Claude, Groq, OpenRouter veya DeepSeek anahtarınızı buraya yapıştırın."/>

                <!-- Optional Custom Base URL (Collapsible/Configurable) -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Özel Base URL (Opsiyonel):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" 
                             Text="{Binding CustomBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Özel bir OpenAI-uyumlu sunucu veya yerel endpoint için (örn: http://localhost:11434/v1)"/>
                </Grid>

                <!-- Live Detection Analysis Result Box -->
                <Border Style="{StaticResource ModernSubCard}" Margin="0,15,0,0" Background="#141721" BorderBrush="#3B425A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource CardDarkBrush}" Margin="0,0,14,0">
                            <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tespit Edilen Sağlayıcı: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding DetectedProvider}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="14"/>
                                <Border Background="#2E364B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DetectionConfidence, StringFormat='Güven: {0}'}" FontSize="11" Foreground="{StaticResource InfoBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DetectionReason}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Pattern Badge -->
                        <Border Grid.Column="2" VerticalAlignment="Center" Background="#1B2236" CornerRadius="6" Padding="8,4" BorderThickness="1" BorderBrush="#2D3A5C">
                            <TextBlock Text="{Binding PatternMatch, StringFormat='Kalıp: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Action Buttons & Progress -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ProbeStatus}" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <Button Grid.Column="1" Content="Temizle" Style="{StaticResource ModernSecondaryButton}" 
                            Command="{Binding ClearInputCommand}" Margin="0,0,10,0"/>

                    <Button Grid.Column="2" Content="⚡ Doğrula, Modelleri Bul ve Kaydet" 
                            Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding ValidateAndSaveCommand}"
                            IsEnabled="{Binding IsProbing, Converter={x:Null}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Saved Keys Vault Section -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kayıtlı ve Doğrulanmış API Anahtarları (DPAPI Kasası)" 
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SavedKeys.Count, StringFormat='Toplam {0} Anahtar'}" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <!-- List of Keys -->
                <ListBox Grid.Row="1" ItemsSource="{Binding SavedKeys}" 
                         SelectedItem="{Binding SelectedKey}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernSubCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Info -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Provider}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#162D24">
                                                <TextBlock Text="{Binding MaskedKey}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DisplaySubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Right: Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Test Et" Style="{StaticResource ModernSecondaryButton}" 
                                                Padding="10,5" FontSize="12" Margin="0,0,8,0"
                                                Command="{Binding DataContext.TestSelectedKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="Sil" Style="{StaticResource ModernDangerButton}"
                                                Command="{Binding DataContext.DeleteKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
