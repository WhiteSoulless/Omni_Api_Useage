<UserControl x:Class="OmniKeyStudio.Views.FreeModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:OmniKeyStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:FreeModelsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Benchmark Controls -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ücretsiz ve Ultra Hızlı Modeller Kataloğu" 
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Groq (500-750 tok/s), Google Gemini 1M bağlam, OpenRouter sıfır maliyetli ve yerel Ollama modelleri." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Seçili Modeli Hız Testine Sok" 
                            Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding BenchmarkSelectedModelCommand}"
                            Margin="0,0,10,0" Padding="14,8"/>

                    <Button Content="💬 Bu Modeli Sohbette Aç" 
                            Style="{StaticResource ModernSecondaryButton}"
                            Command="{Binding UseInChatCommand}"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Models Cards Grid / List -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="10">
            <ListBox ItemsSource="{Binding FreeModelsList}" 
                     SelectedItem="{Binding SelectedModel}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBorder" Background="{StaticResource SurfaceDarkBrush}" 
                                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" 
                                            CornerRadius="10" Padding="14">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#22283A"/>
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Model Title & Provider -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Background="#1C2C40" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Provider}" FontSize="11" Foreground="{StaticResource InfoBrush}"/>
                                </Border>
                                <Border Background="#163828" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                    <TextBlock Text="★ ÜCRETSİZ / DÜŞÜK MALİYET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Right Stats Badges -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Border Background="#28223D" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SpeedRating}" FontSize="11" Foreground="#C084FC" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding ContextWindow}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Model Description -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Text="{Binding Description}" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" 
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Benchmark / Live Result Banner -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Background="#121622" BorderBrush="#2A3550" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="⚡ Test Sonucu:" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding BenchmarkStatus}" Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
