<UserControl x:Class="OmniKeyStudio.Views.CodeVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:OmniKeyStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CodeVaultViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Fast Code Generators -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Özel API Kodları ve Entegrasyon Kasası" 
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Kendi API kodlarınızı, özel sunucu ayarlarınızı kaydedin veya aktif anahtarınız için hazır kod blokları oluşturun." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Quick Generator for Active Key -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aktif Anahtar ile Üret:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="C#" Style="{StaticResource ModernSecondaryButton}" Padding="10,6" Margin="0,0,6,0"
                            Command="{Binding GenerateCodeForProviderCommand}" CommandParameter="csharp"/>
                    <Button Content="Python" Style="{StaticResource ModernSecondaryButton}" Padding="10,6" Margin="0,0,6,0"
                            Command="{Binding GenerateCodeForProviderCommand}" CommandParameter="python"/>
                    <Button Content="cURL" Style="{StaticResource ModernSecondaryButton}" Padding="10,6" Margin="0,0,6,0"
                            Command="{Binding GenerateCodeForProviderCommand}" CommandParameter="curl"/>
                    <Button Content="JS" Style="{StaticResource ModernSecondaryButton}" Padding="10,6"
                            Command="{Binding GenerateCodeForProviderCommand}" CommandParameter="javascript"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Left: Snippets List, Right: Code Editor) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Snippets List -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,14,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Yeni Kod Bloğu Ekle" 
                            Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding NewSnippetCommand}" Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Snippets}" 
                             SelectedItem="{Binding SelectedSnippet}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{StaticResource SurfaceDarkBrush}" 
                                                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" 
                                                    CornerRadius="8" Padding="12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#22283A"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Row="0" Grid.Column="1" Background="#28223D" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding LanguageBadge}" FontSize="10" Foreground="#C084FC" FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Snippet Editor -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Language Inputs -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Başlık:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SnippetTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dil / Biçim:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SnippetLanguage, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Endpoint URL -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Özel Endpoint URL:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SnippetEndpointUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Açıklama:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SnippetDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Code Box -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="API Kodu &amp; İstek Gövdesi:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="📋 Kodu Kopyala" Style="{StaticResource ModernSecondaryButton}" 
                                    HorizontalAlignment="Right" Padding="8,4" FontSize="11"
                                    Command="{Binding CopyCodeCommand}"/>
                        </Grid>
                        <TextBox Grid.Row="1" Style="{StaticResource ModernTextBox}" 
                                 Text="{Binding SnippetCode, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- Save / Delete Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Sil" Style="{StaticResource ModernDangerButton}"
                                Command="{Binding DeleteSnippetCommand}" Padding="14,8"/>

                        <Button Grid.Column="2" Content="💾 Kodu Kasaya Kaydet" Style="{StaticResource ModernPrimaryButton}"
                                Command="{Binding SaveSnippetCommand}" Padding="18,8"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Background="#121622" BorderBrush="#2A3550" Padding="14,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource InfoBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
