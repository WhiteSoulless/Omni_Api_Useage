<UserControl x:Class="OmniKeyStudio.Views.ChatPlaygroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:OmniKeyStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ChatPlaygroundViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Model Selection & Controls Bar -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Seçili Model:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModels}" 
                          SelectedItem="{Binding SelectedModel}"
                          DisplayMemberPath="FullTitle"
                          Height="34" Margin="0,0,15,0"
                          Background="{StaticResource SurfaceDarkBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"/>

                <Button Grid.Column="2" Content="Sohbeti Temizle" Style="{StaticResource ModernSecondaryButton}"
                        Command="{Binding ClearChatCommand}" Margin="0,0,8,0" Padding="12,6"/>

                <Button Grid.Column="3" Content="Durdur" Style="{StaticResource ModernDangerButton}"
                        Command="{Binding StopGenerationCommand}" 
                        IsEnabled="{Binding IsGenerating}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Chat History List -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="10">
            <Grid>
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <!-- User Bubble -->
                                    <Border HorizontalAlignment="Right" MaxWidth="680"
                                            Background="#2B3252" CornerRadius="12,12,2,12" Padding="14,10"
                                            Visibility="{Binding IsUser, Converter={x:Null}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#A5B4FC" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Assistant Bubble -->
                                    <Border HorizontalAlignment="Left" MaxWidth="760"
                                            Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                                            CornerRadius="12,12,12,2" Padding="14,12"
                                            Visibility="{Binding IsAssistant, Converter={x:Null}}">
                                        <StackPanel>
                                            <!-- Model & Stats Header -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Model, StringFormat='🤖 {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                    <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="📋 Kopyala" Style="{StaticResource ModernSecondaryButton}" 
                                                        Padding="6,2" FontSize="10"
                                                        Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <!-- Assistant Content -->
                                            <TextBox Text="{Binding Content, Mode=OneWay}" 
                                                     IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     FontSize="13.5" FontFamily="Segoe UI" Padding="0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State Hint -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="{Binding Messages.Count, Converter={x:Null}}" Opacity="0.5">
                    <TextBlock Text="💬" FontSize="42" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sohbete başlamak için bir mesaj yazın." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="Groq (500+ tok/s), Gemini Flash veya kaydedilmiş herhangi bir model anında yanıt verir." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Input & Streaming Telemetry Bar -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status Indicator -->
            <TextBlock Grid.Row="0" Text="{Binding StreamingStatus}" 
                       Foreground="{StaticResource InfoBrush}" FontSize="11" Margin="4,0,0,6"/>

            <!-- Input Box & Send -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Style="{StaticResource ModernTextBox}" 
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" MaxHeight="100" MinHeight="42"
                             FontSize="13.5" Padding="10"
                             PreviewKeyDown="TextBox_PreviewKeyDown"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Grid.Column="1" Content="Gönder ✈" 
                            Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding SendMessageCommand}"
                            Margin="10,0,0,0" Padding="20,10"
                            IsEnabled="{Binding IsGenerating, Converter={x:Null}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
